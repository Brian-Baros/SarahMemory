{
  "id": "com.softdev0.smartdevice.mqtt.tcp",
  "name": "Smart Device MQTT Driver",
  "type": "driver",
  "version": "2.0.0",
  "author": "SOFTDEV0 LLC / Brian Lee Baros",
  "description": "Protocol-driven MQTT smart-device driver for heterogeneous brokers and topic schemas.",
  "api_compat": {
    "min": "8.0.0",
    "max": "8.9.9"
  },
  "platform": {
    "transport": "tcp",
    "protocols": [
      "mqtt",
      "mqtts"
    ],
    "os": [
      "windows",
      "linux",
      "macos"
    ],
    "backend": [
      "paho-mqtt"
    ]
  },
  "permissions": [
    "network.outbound",
    "filesystem.write_local"
  ],
  "entry": {
    "module": "driver",
    "callable": "driver_init",
    "status_callable": "driver_status",
    "action_callable": "driver_action",
    "shutdown_callable": "driver_shutdown"
  },
  "actions": [
    "ping",
    "probe_backends",
    "get_config",
    "set_config",
    "connect",
    "disconnect",
    "subscribe",
    "unsubscribe",
    "publish",
    "publish_raw",
    "send_command",
    "publish_state",
    "publish_discovery",
    "list_devices",
    "get_topic_state",
    "get_events",
    "clear_events",
    "inject_message",
    "describe_capabilities",
    "safe_stop"
  ],
  "tags": [
    "mqtt",
    "smart-home",
    "iot",
    "broker",
    "telemetry",
    "commands"
  ]
}