{
  "id": "com.softdev0.storage",
  "name": "Storage / Vault Bridge",
  "version": "3.0.0",
  "enabled": true,
  "autoload": false,
  "manufacturer": "SOFTDEV0 LLC",
  "driver_signature": "local_sha256_runtime",
  "signature_type": "sha256",
  "trust_level": "local_unsigned",
  "targets": [
    "storage",
    "smart",
    "nvme",
    "vault_mount"
  ],
  "transport": "local_system",
  "actions_callable": [
    "inventory",
    "smart_summary",
    "nvme_summary",
    "vault_status",
    "vault_register_mount",
    "vault_auto_mount",
    "mount",
    "unmount"
  ],
  "status_callable": "driver_status",
  "action_callable": "driver_action",
  "shutdown_callable": "driver_shutdown"
}