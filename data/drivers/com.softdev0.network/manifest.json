{
  "driver_id": "com.softdev0.network",
  "name": "Network Adapter / Modem Bridge",
  "version": "2.0.0",
  "entry": "driver.py",
  "platform": {
    "os": [
      "windows",
      "linux",
      "macos"
    ],
    "transport": [
      "pci",
      "usb",
      "ethernet",
      "wifi",
      "cellular",
      "bluetooth"
    ],
    "architectures": [
      "x86_64",
      "arm64"
    ]
  },
  "status_callable": "driver_status",
  "action_callable": "driver_action",
  "shutdown_callable": "driver_shutdown",
  "actions": [
    "probe_backends",
    "discover_adapters",
    "list_interfaces",
    "select_preferred_interface",
    "describe_capabilities",
    "get_config",
    "set_config",
    "safe_stop"
  ],
  "permissions": [
    "subprocess",
    "filesystem_read"
  ]
}