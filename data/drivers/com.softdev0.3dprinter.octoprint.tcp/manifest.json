{
  "id": "com.softdev0.3dprinter.octoprint.tcp",
  "name": "3D Printer (OctoPrint) Driver",
  "type": "driver",
  "version": "1.1.0",
  "author": "SOFTDEV0 LLC / Brian Lee Baros",
  "summary": "Governed OctoPrint TCP/HTTP driver for SarahMemory AiOS.",
  "description": {
    "overview": "Provides governed network control and status telemetry for OctoPrint-managed 3D printers through the OctoPrint REST API.",
    "capabilities": [
      "Connectivity validation and live status polling",
      "Printer connection and disconnect control",
      "Job lifecycle control: start, pause, resume, restart, cancel",
      "Governed safe-stop workflow with cooldown and optional park/motor release",
      "Direct G-code command pass-through when explicitly requested"
    ],
    "notes": [
      "Requires a reachable OctoPrint base URL and valid API key.",
      "Designed as a SarahMemory AiOS governed driver package, not a standalone daemon.",
      "Actions that mutate printer state should be routed through Action Lane governance."
    ]
  },
  "configuration": [
    {
      "id": "connection",
      "title": "Connection",
      "fields": [
        {
          "key": "base_url",
          "label": "OctoPrint URL",
          "type": "string",
          "required": true,
          "placeholder": "http://192.168.1.60"
        },
        {
          "key": "api_key",
          "label": "API Key",
          "type": "secret",
          "required": true,
          "placeholder": "Paste OctoPrint API key"
        },
        {
          "key": "timeout_sec",
          "label": "HTTP Timeout (seconds)",
          "type": "number",
          "required": false,
          "default": 10
        },
        {
          "key": "verify_tls",
          "label": "Verify TLS certificates",
          "type": "bool",
          "required": false,
          "default": true
        }
      ]
    },
    {
      "id": "boot",
      "title": "Boot Behavior",
      "fields": [
        {
          "key": "enabled",
          "label": "Enabled",
          "type": "bool",
          "default": true
        },
        {
          "key": "autoload",
          "label": "Autoload on boot",
          "type": "bool",
          "default": false
        },
        {
          "key": "auto_connect_on_init",
          "label": "Auto-connect printer on init",
          "type": "bool",
          "default": false
        }
      ]
    },
    {
      "id": "printer_connection",
      "title": "Printer Connection Defaults",
      "fields": [
        {
          "key": "connection.port",
          "label": "Serial Port",
          "type": "string",
          "required": false,
          "placeholder": "AUTO or /dev/ttyUSB0"
        },
        {
          "key": "connection.baudrate",
          "label": "Baudrate",
          "type": "number",
          "required": false,
          "placeholder": "115200"
        },
        {
          "key": "connection.printerProfile",
          "label": "Printer Profile",
          "type": "string",
          "required": false,
          "placeholder": "_default"
        },
        {
          "key": "connection.save",
          "label": "Save connection as default",
          "type": "bool",
          "default": false
        },
        {
          "key": "connection.autoconnect",
          "label": "OctoPrint autoconnect",
          "type": "bool",
          "default": false
        }
      ]
    },
    {
      "id": "safe_stop",
      "title": "Safe Stop Defaults",
      "fields": [
        {
          "key": "safe_stop.cancel_job_first",
          "label": "Cancel active job first",
          "type": "bool",
          "default": true
        },
        {
          "key": "safe_stop.cooldown_hotend",
          "label": "Cooldown hotend",
          "type": "bool",
          "default": true
        },
        {
          "key": "safe_stop.cooldown_bed",
          "label": "Cooldown bed",
          "type": "bool",
          "default": true
        },
        {
          "key": "safe_stop.disable_steppers",
          "label": "Disable steppers after stop",
          "type": "bool",
          "default": false
        },
        {
          "key": "safe_stop.park_head",
          "label": "Park head",
          "type": "bool",
          "default": false
        },
        {
          "key": "safe_stop.park_x",
          "label": "Park X",
          "type": "number",
          "default": 0
        },
        {
          "key": "safe_stop.park_y",
          "label": "Park Y",
          "type": "number",
          "default": 0
        },
        {
          "key": "safe_stop.park_z_lift",
          "label": "Z Lift",
          "type": "number",
          "default": 5
        }
      ]
    }
  ],
  "api_compat": {
    "min": "8.0.0",
    "max": "8.9.9"
  },
  "transport": {
    "protocol": "tcp/http",
    "target": "OctoPrint REST API"
  },
  "permissions": [
    "network.outbound"
  ],
  "entry": {
    "module": "driver",
    "callable": "driver_init"
  },
  "actions": [
    "ping",
    "status",
    "version",
    "connect",
    "disconnect",
    "safe_stop",
    "start_job",
    "pause_job",
    "resume_job",
    "restart_job",
    "cancel_job",
    "send_gcode"
  ]
}
