{
  "id": "com.softdev0.keyboard.hid",
  "name": "Keyboard HID Driver",
  "type": "driver",
  "version": "1.0.0",
  "author": "SOFTDEV0 LLC / Brian Lee Baros",
  "description": "Governed HID keyboard monitoring and key mapping driver for SarahMemory.",
  "api_compat": {
    "min": "8.0.0",
    "max": "8.9.9"
  },
  "platform": {
    "transport": "hid",
    "os": [
      "windows",
      "linux",
      "macos"
    ],
    "notes": "Requires HID backend availability and OS permission gating for keyboard capture."
  },
  "permissions": [
    "hardware.hid",
    "os.input_monitoring"
  ],
  "entry": {
    "module": "driver",
    "callable": "driver_init"
  },
  "status_callable": "driver_status",
  "action_callable": "driver_action",
  "shutdown_callable": "driver_shutdown",
  "actions_supported": [
    "ping",
    "probe_backend",
    "list_hid",
    "open_device",
    "close_device",
    "read_once",
    "start_listen",
    "stop_listen",
    "get_buffer",
    "clear_buffer",
    "get_config",
    "set_config",
    "inject_report",
    "feed_keystrokes",
    "safe_stop"
  ],
  "tags": [
    "keyboard",
    "hid",
    "input",
    "monitoring"
  ]
}