{
  "id": "com.softdev0.arduino.usb",
  "name": "Arduino USB Driver (Uno R3 / AVR)",
  "type": "driver",
  "version": "1.0.0",
  "author": "SOFTDEV0 LLC / SarahMemory Community",
  "description": "Governed USB serial driver for Arduino-class boards using arduino-cli for discovery, compile, and upload workflows.",
  "api_compat": {
    "min": "8.0.0",
    "max": "8.9.9"
  },
  "platform": [
    "windows",
    "linux",
    "mac"
  ],
  "transport": "usb/serial",
  "category": "microcontroller",
  "permissions": [
    "hardware.usb",
    "hardware.serial",
    "filesystem.write_local",
    "os.process_control"
  ],
  "entry": {
    "module": "driver",
    "callable": "driver_init"
  },
  "actions_callable": "driver_action",
  "status_callable": "driver_status",
  "shutdown_callable": "driver_shutdown",
  "supports": [
    "arduino:avr:uno"
  ]
}
