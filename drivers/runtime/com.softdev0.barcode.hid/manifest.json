{
  "id": "com.softdev0.barcode.hid",
  "name": "Barcode Scanner HID Driver",
  "type": "driver",
  "version": "1.0.0",
  "author": "SOFTDEV0 LLC / SarahMemory Community",
  "description": "Governed HID barcode scanner driver with enumeration, buffered scan capture, keyboard-wedge parsing, and safe listener controls.",
  "api_compat": {"min": "8.0.0", "max": "8.9.9"},
  "platform": ["windows", "linux", "mac"],
  "transport": "hid",
  "category": "barcode",
  "tags": ["barcode", "scanner", "hid", "usb", "keyboard-wedge"],
  "permissions": ["hardware.usb", "os.input_control"],
  "entry": {"module": "driver", "callable": "driver_init"},
  "status_callable": "driver_status",
  "action_callable": "driver_action",
  "shutdown_callable": "driver_shutdown",
  "actions": ["ping", "list_hid", "select_device", "start_listen", "stop_listen", "read_once", "inject_report", "feed_keystrokes", "parse_text", "get_buffer", "clear_buffer", "get_config", "set_config", "safe_stop"]
}
