{
  "id": "com.softdev0.plc.opcua.tcp",
  "name": "PLC OPC UA Driver",
  "type": "driver",
  "version": "1.0.0",
  "author": "SOFTDEV0 LLC / Brian Lee Baros",
  "description": "Governed OPC UA client driver for PLC connectivity over opc.tcp with browse/read/write/method/subscription support.",
  "api_compat": {
    "min": "8.0.0",
    "max": "8.9.9"
  },
  "platform": {
    "transport": "tcp",
    "protocol": "opcua",
    "client_only": true,
    "os": [
      "windows",
      "linux",
      "macos"
    ]
  },
  "permissions": [
    "network.outbound",
    "filesystem.read_local",
    "filesystem.write_local"
  ],
  "entry": {
    "module": "driver",
    "callable": "driver_init"
  },
  "status_callable": "driver_status",
  "action_callable": "driver_action",
  "shutdown_callable": "driver_shutdown",
  "actions": [
    "ping",
    "probe_backends",
    "connect",
    "disconnect",
    "browse",
    "read_node",
    "write_node",
    "call_method",
    "create_subscription",
    "delete_subscription",
    "get_events",
    "clear_events",
    "namespace_array",
    "get_config",
    "set_config",
    "safe_stop"
  ],
  "tags": [
    "plc",
    "opcua",
    "industrial",
    "client",
    "tcp"
  ]
}