{
  "id": "com.softdev0.mouse.hid",
  "name": "Mouse HID Driver",
  "type": "driver",
  "version": "1.0.0",
  "author": "SOFTDEV0 LLC / Brian Lee Baros",
  "description": "HID mouse enumeration, capture, report decoding, motion/button/wheel buffering, and governed output-control gating for SarahMemory AiOS.",
  "api_compat": {
    "min": "8.0.0",
    "max": "8.9.9"
  },
  "platform": {
    "transports": [
      "hid",
      "usb"
    ],
    "os": [
      "windows",
      "linux",
      "macos"
    ],
    "notes": [
      "Live capture requires a HID backend such as hidapi/python-hid.",
      "OS-level output control is intentionally gated and disabled by default.",
      "Feature availability depends on what the device and OS expose."
    ]
  },
  "permissions": [
    "hardware.hid",
    "hardware.usb",
    "os.input_monitor"
  ],
  "entry": {
    "module": "driver",
    "callable": "driver_init"
  },
  "status_callable": "driver_status",
  "action_callable": "driver_action",
  "shutdown_callable": "driver_shutdown",
  "actions": [
    "ping",
    "probe_backend",
    "discover_devices",
    "connect",
    "disconnect",
    "read_once",
    "start_listen",
    "stop_listen",
    "get_buffer",
    "clear_buffer",
    "get_config",
    "set_config",
    "inject_report",
    "feed_events",
    "safe_stop"
  ],
  "tags": [
    "mouse",
    "hid",
    "usb",
    "input",
    "pointer"
  ]
}