  "fields": [
    {
      "key": "host",
      "label": "Printer Host/IP",
      "type": "string",
      "placeholder": "192.168.1.50"
    },
    {
      "key": "port",
      "label": "Port",
      "type": "int",
      "min": 1,
      "max": 65535
    },
    {
      "key": "mode",
      "label": "Mode",
      "type": "string",
      "placeholder": "raw_tcp|lpr|ipp|ipps|cups_socket|shell_lp|shell_lpr"
    },
    {
      "key": "queue",
      "label": "Queue",
      "type": "string",
      "placeholder": "lp"
    },
    {
      "key": "uri",
      "label": "Printer URI",
      "type": "string",
      "placeholder": "socket://host:9100 or ipp://host/ipp/print"
    },
    {
      "key": "job_name",
      "label": "Job Name",
      "type": "string"
    },
    {
      "key": "copies",
      "label": "Copies",
      "type": "int",
      "min": 1,
      "max": 999
    },
    {
      "key": "duplex",
      "label": "Duplex",
      "type": "string",
      "placeholder": "none|long_edge|short_edge"
    },
    {
      "key": "media",
      "label": "Media",
      "type": "string",
      "placeholder": "A4|Letter|Legal"
    },
    {
      "key": "color_mode",
      "label": "Color Mode",
      "type": "string",
      "placeholder": "auto|monochrome|color"
    },
    {
      "key": "allow_raw_bytes",
      "label": "Allow Raw Bytes",
      "type": "bool"
    },
    {
      "key": "require_print_confirmation",
      "label": "Require Print Confirmation",
      "type": "bool"
    }
  ],
  "supported_actions": [
    "ping",
    "probe_backends",
    "connect",
    "disconnect",
    "print_text",
    "print_raw",
    "print_file",
    "print_test",
    "describe_capabilities",
    "safe_stop",
    "get_config",
    "set_config"
  ]
