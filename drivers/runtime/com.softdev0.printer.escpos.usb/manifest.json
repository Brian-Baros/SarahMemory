{
  "id": "com.softdev0.printer.escpos.usb",
  "name": "ESC/POS Receipt Printer Driver",
  "type": "driver",
  "version": "1.0.0",
  "author": "SOFTDEV0 LLC / Brian Lee Baros",
  "description": "Governed USB ESC/POS receipt printer driver with discovery, connection lifecycle, text/image/barcode/QR printing, paper control, and guarded raw-command support.",
  "api_compat": {
    "min": "8.0.0",
    "max": "8.9.9"
  },
  "platform": {
    "os": [
      "windows",
      "linux",
      "macos"
    ],
    "transport": "usb",
    "device_class": "receipt_printer",
    "protocols": [
      "escpos"
    ]
  },
  "permissions": [
    "hardware.usb",
    "filesystem.write_local",
    "os.process_control"
  ],
  "entry": {
    "module": "driver",
    "callable": "driver_init",
    "status_callable": "driver_status",
    "action_callable": "driver_action",
    "shutdown_callable": "driver_shutdown"
  },
  "actions": [
    "ping",
    "probe_backends",
    "discover_devices",
    "get_config",
    "set_config",
    "connect",
    "disconnect",
    "print_text",
    "print_test",
    "print_barcode",
    "print_qr",
    "print_image",
    "feed",
    "cut",
    "cash_drawer",
    "send_raw",
    "safe_stop"
  ],
  "tags": [
    "printer",
    "receipt",
    "escpos",
    "usb",
    "thermal"
  ]
}